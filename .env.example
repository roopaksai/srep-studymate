# ===== SREP StudyMate =====
# Copy this file to .env.local and fill in the values

# --- Required ---
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/srep-studymate

# JWT secret (min 32 chars, generate with: openssl rand -base64 32)
JWT_SECRET=

# OpenRouter API key (free at https://openrouter.ai)
OPENROUTER_API_KEY=

# --- Optional (AI models override defaults) ---
# AI_PROVIDER=openrouter
# AI_MODEL=google/gemma-4-31b-it:free
# AI_MODEL_FLASHCARDS=google/gemma-4-31b-it:free
# AI_MODEL_MOCK_QUESTIONS=nvidia/nemotron-3-super-120b-a12b:free
# AI_MODEL_ANALYSIS=openai/gpt-oss-120b:free
# AI_MODEL_SCHEDULE=google/gemma-4-26b-a4b-it:free
# AI_MODEL_TOPICS=meta-llama/llama-3.3-70b-instruct:free

# --- Optional (app config) ---
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
# NODE_ENV=production
